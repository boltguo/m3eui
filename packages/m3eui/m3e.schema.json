{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/m3eui@0.1.0/m3e.schema.json",
  "title": "m3e.json",
  "description": "m3eui project configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI."
    },
    "style": {
      "type": "string",
      "enum": ["expressive", "standard"],
      "default": "expressive",
      "description": "Visual and motion preset."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "default": "#6750A4",
          "description": "Hex seed color for HCT palette generation."
        },
        "schemeVariant": {
          "type": "string",
          "enum": ["expressive", "tonalSpot", "vibrant", "neutral"],
          "default": "expressive",
          "description": "Dynamic color scheme variant."
        },
        "colorMode": {
          "type": "string",
          "enum": ["system", "light", "dark"],
          "default": "system",
          "description": "Initial color-scheme value."
        },
        "contrastLevel": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0,
          "description": "Contrast level in [-1, 1]."
        },
        "motionScheme": {
          "type": "string",
          "enum": ["expressive", "standard"],
          "default": "expressive",
          "description": "Spring motion scheme."
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "default": "en-US",
          "examples": ["zh-CN", "en-US", "ja-JP", "ar-SA"],
          "description": "BCP 47 locale tag."
        },
        "direction": {
          "type": "string",
          "enum": ["auto", "ltr", "rtl"],
          "default": "auto",
          "description": "Text direction."
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Message key overrides."
        }
      }
    },
    "csp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nonce": {
          "type": "string",
          "description": "CSP nonce passed to CSPProvider."
        },
        "disableStyleElements": {
          "type": "boolean",
          "default": false,
          "description": "Disable inline style element injection."
        }
      }
    },
    "css": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string",
          "default": "src/styles/m3e-theme.css",
          "description": "Output path for generated theme CSS."
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "string",
          "default": "@/components/ui"
        },
        "tokens": {
          "type": "string",
          "default": "m3eui/tokens"
        },
        "i18n": {
          "type": "string",
          "default": "@/i18n"
        }
      }
    }
  }
}
