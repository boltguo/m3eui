{
  "name": "m3eui",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Material 3 Expressive React component library built on @base-ui/react with HCT dynamic color, spring physics, and built-in i18n/RTL.",
  "author": {
    "name": "boltguo",
    "url": "https://github.com/boltguo"
  },
  "keywords": [
    "react",
    "material-3",
    "material-3-expressive",
    "m3e",
    "material-design",
    "material-you",
    "base-ui",
    "components",
    "ui",
    "design-system",
    "hct",
    "dynamic-color",
    "spring-physics",
    "a11y",
    "rtl",
    "i18n",
    "typescript"
  ],
  "homepage": "https://m3eui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltguo/m3eui.git",
    "directory": "packages/m3eui"
  },
  "bugs": {
    "url": "https://github.com/boltguo/m3eui/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "m3eui": "./dist/cli/bin.js",
    "m3e": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "m3e.schema.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./m3e.schema.json": "./m3e.schema.json",
    "./package.json": "./package.json",
    "./components/_*": null,
    "./components/*": {
      "types": "./dist/components/*/*.d.ts",
      "import": "./dist/components/*/*.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
