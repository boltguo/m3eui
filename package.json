{
  "name": "m3eui-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "boltguo",
    "url": "https://github.com/boltguo"
  },
  "homepage": "https://m3eui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltguo/m3eui.git"
  },
  "bugs": {
    "url": "https://github.com/boltguo/m3eui/issues"
  },
  "description": "Material 3 Expressive React component library monorepo.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter m3eui-playground dev",
    "build": "pnpm --filter m3eui build && node packages/m3eui/dist/cli/bin.js sync && pnpm --filter m3eui-playground build",
    "build:lib": "pnpm --filter m3eui build",
    "clean": "pnpm --filter m3eui clean",
    "m3eui": "node packages/m3eui/dist/cli/bin.js",
    "m3e": "node packages/m3eui/dist/cli/bin.js",
    "m3e:sync": "node packages/m3eui/dist/cli/bin.js sync",
    "m3e:doctor": "node packages/m3eui/dist/cli/bin.js doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm build && pnpm m3e:doctor && pnpm typecheck && pnpm test",
    "release": "pnpm build && pnpm --filter m3eui publish --no-git-checks --access public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
